{
  "id": "palace.example",
  "name": "Palace overview",
  "version": "1.1.0",
  "apiVersion": 1,
  "main": "main.js",
  "description": "Example plugin: palace statistics and adding a locus at the center of the active floor.",
  "permissions": [
    "project.read",
    "markers.write",
    "ui.contribute"
  ],
  "contributes": {
    "commands": [
      {
        "id": "palace.example.summary",
        "title": "Open overview"
      },
      {
        "id": "palace.example.center",
        "title": "Add locus at center"
      }
    ],
    "panels": [
      {
        "id": "palace.example.panel",
        "title": "Palace overview"
      }
    ],
    "activityBar": [
      {
        "id": "palace.example.activity",
        "title": "Palace overview",
        "icon": "icon.svg",
        "command": "palace.example.summary"
      }
    ],
    "toolbars": [
      {
        "id": "palace.example.centerTool",
        "title": "Locus at center",
        "location": "plan",
        "icon": "pin",
        "command": "palace.example.center"
      }
    ]
  }
}
