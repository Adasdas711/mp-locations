{
  "id": "palace.example",
  "name": "Сводка дворца",
  "version": "1.1.0",
  "apiVersion": 1,
  "main": "main.js",
  "description": "Пример: панель статистики дворца и добавление локуса в центр активного этажа.",
  "permissions": [
    "project.read",
    "markers.write",
    "ui.contribute"
  ],
  "contributes": {
    "commands": [
      {
        "id": "palace.example.summary",
        "title": "Открыть сводку"
      },
      {
        "id": "palace.example.center",
        "title": "Добавить локус в центре"
      }
    ],
    "panels": [
      {
        "id": "palace.example.panel",
        "title": "Сводка дворца"
      }
    ],
    "activityBar": [
      {
        "id": "palace.example.activity",
        "title": "Сводка дворца",
        "icon": "icon.svg",
        "command": "palace.example.summary"
      }
    ],
    "toolbars": [
      {
        "id": "palace.example.centerTool",
        "title": "Локус в центре",
        "location": "plan",
        "icon": "pin",
        "command": "palace.example.center"
      }
    ]
  }
}
