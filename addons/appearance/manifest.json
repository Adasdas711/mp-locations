{
  "id": "palace.appearance",
  "name": "Themes and icons",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "main.js",
  "description": "Install themes and icon sets, import your own JSON and customize them independently.",
  "permissions": [
    "ui.control",
    "ui.contribute"
  ],
  "contributes": {
    "commands": [
      {
        "id": "palace.appearance.open",
        "title": "Themes and icons: open catalog"
      }
    ],
    "panels": [
      {
        "id": "palace.appearance.panel",
        "title": "Themes and icons"
      }
    ],
    "activityBar": [
      {
        "id": "palace.appearance.activity",
        "title": "Themes and icons",
        "icon": "palette",
        "command": "palace.appearance.open"
      }
    ]
  }
}
